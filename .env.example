# Safe defaults: automation and final external actions remain disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# După un mesaj vocal, răspunsurile sunt trimise text + audio în această fereastră.
VOICE_REPLY_HOURS=24
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_TEMPLATE_LANGUAGE=ro
# Completează numai după aprobarea șabloanelor în WhatsApp Manager.
WHATSAPP_TEMPLATE_MECHANIC_SCHEDULE=
WHATSAPP_TEMPLATE_DELAY=
WHATSAPP_TEMPLATE_OFFER=
WHATSAPP_TEMPLATE_REQUEST=

ADMIN_API_TOKEN=
ADMIN_USER=administrator
# Cont separat pentru postul din recepție. Nu reutiliza ADMIN_API_TOKEN.
ALLOW_REMOTE_DASHBOARD=false
ALLOWED_RECEPTION_IPS=
ALBATROS_BIND_HOST=127.0.0.1
RECEPTION_DASHBOARD_USER=consilier
RECEPTION_DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TTL_SECONDS=28800
# true când accesul se face prin HTTPS; false este permis numai pentru un test LAN temporar.
DASHBOARD_COOKIE_SECURE=true
# Legătura privată Render -> instalația Windows. Secret separat, minimum 32 caractere.
# Se păstrează numai în mediu; nu se trimite către browser sau către furnizori.
RECEPTION_BRIDGE_URL=
RECEPTION_BRIDGE_SECRET=
ROBOT_ENABLED=false
BETA_MODE=true

ALBATROS_DATA_DIR=./data
ALBATROS_OFFERING_DIR=./offering
ALBATROS_TECHNICIAN_PYTHON=
ALBATROS_TECHNICIAN_WORKER=
ALBATROS_BROWSER_PROFILE=./browser_profiles/albatros_robot

PUBLIC_RATE_LIMIT=60
PUBLIC_RATE_WINDOW_SECONDS=60
WHATSAPP_BUFFER_SECONDS=8
ROBOT_MAX_RETRIES=2
BOOKING_ROUND_MINUTES=30
BOOKING_BUFFER_HOURS=1.0
ALBATROS_TIME_FACTOR=1.0
BETA_TEST_PHONES=

# Programator: citește DSM fără modificări la 17:00 pentru ziua următoare,
# apoi trimite fiecărui mecanic programul zilei curente la 08:00.
DSM_SCHEDULE_IMPORT_TIME=17:00
SCHEDULER_CLIENT_NOTIFICATIONS=false
MECHANIC_SCHEDULE_SEND_TIME=08:00

# Optional private settings for an explicitly authorized pre-reception pilot.
# Never commit real recipient numbers or vehicle identifiers.
PRE_RECEPTION_TEST_PHONES=
PRE_RECEPTION_PILOT_OFFER_ID=
PRE_RECEPTION_PILOT_VIN=
PRE_RECEPTION_PILOT_REGISTRATION=
PRE_RECEPTION_PILOT_RETEST_ORDER_ID=
