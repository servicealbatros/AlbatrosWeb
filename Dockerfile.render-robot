FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TZ=Europe/Bucharest \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright ROBOT_ENABLED=false BETA_MODE=true
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && python -m playwright install --with-deps chromium \
    && apt-get update && apt-get install -y --no-install-recommends xvfb xauth \
    && rm -rf /var/lib/apt/lists/*
COPY *.py ./
COPY static ./static
COPY edge_robot_extension_V6_TALON_MATCH ./edge_robot_extension_V6_TALON_MATCH
COPY scripts/render_robot_runtime.py ./scripts/render_robot_runtime.py
COPY scripts/render_single_app.py ./scripts/render_single_app.py
COPY scripts/restore_cloud_migration.py ./scripts/restore_cloud_migration.py
COPY scripts/dsm_session_keeper.py ./scripts/dsm_session_keeper.py
RUN python -m unittest test_browser_resources.py test_render_runtime.py test_reception_bridge.py test_cloud_access.py test_cloud_migration.py test_provider_console.py test_schedule_import_control.py test_mechanic_schedule_clock.py test_dsm_session_vault.py test_autototal_oe_price_identity.py test_workshop_consumables.py test_transmission_service_policy.py test_offer_scope_validation.py
RUN useradd --create-home --uid 10001 albatros \
    && mkdir -p /var/data/albatros /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix \
    && chown -R albatros:albatros /var/data/albatros /app
USER albatros
CMD ["python", "scripts/render_robot_runtime.py"]
